# oriri.me on cPanel (Apache). Copied into dist/ by Vite on every build.
Options -Indexes
RewriteEngine On

# 1. Always HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Bare domain -> www (www.oriri.me is the main address)
RewriteCond %{HTTP_HOST} ^oriri\.me$ [NC]
RewriteRule ^ https://www.oriri.me%{REQUEST_URI} [L,R=301]

# 3. Single-page app: any path that isn't a real file opens index.html
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ /index.html [L]

<IfModule mod_headers.c>
  # Hashed build files never change, so browsers can keep them for a year
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The page itself is always re-checked so new deploys show up immediately
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set Strict-Transport-Security "max-age=2628000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
