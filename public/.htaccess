# oriri.me on cPanel (Apache). Copied into dist/ by Vite on every build.
Options -Indexes
RewriteEngine On

# 1. Always HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Bare domain -> www (www.oriri.me is the main address)
RewriteCond %{HTTP_HOST} ^oriri\.me$ [NC]
RewriteRule ^ https://www.oriri.me%{REQUEST_URI} [L,R=301]

# 3. Data relay: /api/fn/<path> goes to the Supabase function through api/fn.php
#    (same site, so phones never make a cross-site request). Keep the login header.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^api/fn/(.+)$ api/fn.php?p=$1 [QSA,L]

# 4. Staging (new.oriri.me) is never indexed: own robots.txt and a noindex header
RewriteCond %{HTTP_HOST} ^new\.oriri\.me$ [NC]
RewriteRule ^robots\.txt$ robots-staging.txt [L]
SetEnvIfNoCase Host ^new\.oriri\.me$ ORIRI_STAGING

# 5. Each page has its own pre-built HTML (title, description, text) for search engines
RewriteRule ^plan/(inputs|day)/?$ plan__$1.html [L]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z-]+)$ $1.html [L]

# 6. Single-page app: any path that isn't a real file opens index.html
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ /index.html [L]

<IfModule mod_headers.c>
  # Hashed build files never change, so browsers can keep them for a year
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The page itself is always re-checked so new deploys show up immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set Strict-Transport-Security "max-age=2628000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Robots-Tag "noindex, nofollow" env=ORIRI_STAGING
</IfModule>
